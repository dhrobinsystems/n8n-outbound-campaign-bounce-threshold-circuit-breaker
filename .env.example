# =============================================================================
# n8n-outbound-campaign-bounce-threshold-circuit-breaker - configuration template
# -----------------------------------------------------------------------------
# Set these on your n8n host (docker-compose `environment:`, systemd
# EnvironmentFile or your platform's secret manager). NEVER commit a real .env.
#
# API keys for Smartlead, Instantly, Slack and Twilio do NOT go here: they live
# in n8n Credentials (see README > Setup). Required n8n host setting:
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false   # Code nodes read the variables below
#
# ⚠️ Disclaimer & Liability Limitation: use at your own risk. The author and
# dhRobin Systems assume no responsibility or liability for any damages
# resulting from the use, misuse, or deployment of these scripts.
# See DISCLAIMER.md. Released under the MIT License.
# =============================================================================

# --- Safety -------------------------------------------------------------------
# true (default): evaluate only and post a dry-run report. Nothing is paused,
# scrubbed or paged. Only false/0/no/off enable live mode.
SANDBOX_MODE=true
# true: use the built-in fictional campaigns instead of calling the platform API.
# Only allowed together with SANDBOX_MODE=true.
MOCK_STATS=false

# --- Platform -----------------------------------------------------------------
# smartlead | instantly
PLATFORM=smartlead

# --- Thresholds (percent) -------------------------------------------------------
# Rolling window evaluated on every run (days, inclusive, UTC).
LOOKBACK_DAYS=7
# A campaign is only judged once it has at least this many leads contacted
# (or emails sent if the platform does not report unique contacts).
MIN_SENT_FOR_EVALUATION=100
# Breaker trips when the bounce rate EXCEEDS this value (strictly greater).
BOUNCE_RATE_TRIP_PERCENT=3
# Alert-only band below the trip threshold.
BOUNCE_RATE_WARN_PERCENT=2
# Spam-complaint thresholds (Google's bulk-sender guidance: keep the spam rate
# below 0.3%, ideally under 0.1%). Only applied when a complaint count exists.
SPAM_RATE_TRIP_PERCENT=0.3
SPAM_RATE_WARN_PERCENT=0.1
# Alert-only early-warning signal.
UNSUBSCRIBE_RATE_WARN_PERCENT=2
# Optional dotted path to a spam-complaint count in the analytics response
# (e.g. spam_count). Leave empty to auto-detect common field names.
SPAM_COUNT_FIELD=

# --- Breaker behaviour ----------------------------------------------------------
# After the breaker pauses a campaign, a manual resume is respected for this
# many hours before the breaker can trip again.
REARM_HOURS=24
# Warnings for the same campaign are re-sent at most once per window.
WARN_REALERT_HOURS=24
# Upper bound on automatic pauses per run (extra breaches are alert-only).
MAX_PAUSES_PER_RUN=25
# Optional comma-separated campaign IDs to monitor exclusively / to ignore.
CAMPAIGN_ALLOWLIST=
CAMPAIGN_DENYLIST=

# --- Lead scrubbing ---------------------------------------------------------------
# Smartlead: pause bounced leads that are still in progress in the tripped campaign.
# Instantly: add bounced emails to the workspace block list (affects ALL campaigns).
SCRUB_LEADS=true
# Instantly only: after bounced leads, also block leads flagged "risky".
SCRUB_INCLUDE_RISKY=false
# Leads handled per campaign per run (1-100); the next run continues.
SCRUB_PAGE_SIZE=100

# --- Alerts -----------------------------------------------------------------------
# Channel ID (C0123ABCD), #channel-name, or a user ID (U0123ABCD) for a DM.
SLACK_ALERT_CHANNEL=#deliverability-alerts
# Optional: the deliverability engineer's Slack user ID, @-mentioned on alerts.
DELIVERABILITY_ENGINEER_SLACK_ID=
# Where sandbox dry-run reports go (defaults to SLACK_ALERT_CHANNEL).
SLACK_REPORT_CHANNEL=

# --- SMS (optional, Twilio) --------------------------------------------------------
SMS_ENABLED=false
# Your Twilio Account SID (the auth token goes in the n8n Basic Auth credential).
TWILIO_ACCOUNT_SID=
# E.164 numbers. Keep real numbers out of git.
TWILIO_FROM_NUMBER=
ONCALL_SMS_NUMBER=
